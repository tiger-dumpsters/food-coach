{
  "appId": "com.gethungerhush.app",
  "appName": "HungerHush",
  "webDir": "public",
  "server": {
    "url": "https://gethungerhush.com/app",
    "allowNavigation": [
      "*.gethungerhush.com",
      "accounts.google.com",
      "api.revenuecat.com",
      "billing.stripe.com",
      "checkout.stripe.com",
      "food-app-55f7d.firebaseapp.com",
      "gethungerhush.com"
    ],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1E1830",
    "scheme": "HungerHush"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#1E1830",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com"
      ]
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          },
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        },
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}