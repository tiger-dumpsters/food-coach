rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own data. Nobody else -- including
    // other beta users and household members -- can see anything under users/{uid}.
    // (Meals shared with a household member are copied into their log by the server.)
    match /users/{uid} {
      function isOwner() { return request.auth != null && request.auth.uid == uid; }
      // Beta access fields are set only by the server (invite links), never by the app.
      function noAccessFields() { return !request.resource.data.keys().hasAny(['access', 'invitedBy', 'inviteCode', 'accessAt']); }
      function accessUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['access', 'invitedBy', 'inviteCode', 'accessAt']);
      }
      allow read, delete: if isOwner();
      allow create: if isOwner() && noAccessFields();
      allow update: if isOwner() && accessUnchanged();

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Households: members can read the household (names + shared pantry) and edit the
    // pantry. Membership changes go through the server (invite codes).
    match /households/{hid} {
      function isMember() {
        return request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
      allow read: if isMember();
      allow update: if isMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pantry']);

      // Shared food numbers: members can read; the server writes.
      match /foods/{food} {
        allow read: if isMember();
      }
    }

    // Everything else is closed (invite codes, access invites, usage counters, push keys).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
